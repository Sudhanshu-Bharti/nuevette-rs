# Required: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: finds the official docs for topics not in the built-in list.
# Without it, paths are generated from Gemini's own knowledge.
SERPAPI_API_KEY=

# Models. GEMINI_MODEL defaults to gemini-3.1-flash-lite. A fallback is only
# used when named here; it's tried when the primary is overloaded or out of quota.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=none
